      "source": [
        "string = input(\"Enter a Binary string: \")\n",
        "\n",
        "zeros = 0\n",
        "ones = 0\n",
        "\n",
        "for ch in string:\n",
        "    if ch not in ('0', '1'):\n",
        "        print(\"Invalid Input\")\n",
        "        exit()\n",
        "\n",
        "    if ch == '0':\n",
        "        zeros += 1\n",
        "    else:\n",
        "        ones += 1\n",
        "\n",
        "if zeros % 2 == 0 and ones % 2 == 0:\n",
        "    print(\"Accepted: Even number of 0's and even number of 1's.\")\n",
